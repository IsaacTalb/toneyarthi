{
  "name": "toneyarthi",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "mobile:start": "pnpm --filter @toneyarthi/mobile start",
    "mobile:config": "pnpm --filter @toneyarthi/mobile exec expo config --type public",
    "workers:dry-run": "pnpm --filter './workers/*' run deploy:dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "wrangler": "^4.33.1"
  }
}
