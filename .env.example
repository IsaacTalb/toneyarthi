# Public URL used by the mobile client. Copy this file to .env for local use.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_SITE_URL=https://toneyarthi.com

# Public R2 development domain or, in production, the bucket's custom domain.
MEDIA_PUBLIC_BASE_URL=https://pub-account-specific-id.r2.dev

# Cloudflare identifiers and secrets will be introduced with their integrations.
INGEST_TRIGGER_SECRET=replace-with-a-development-secret

# Gemini client credentials and model selections (server-side only).
GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_TEXT_MODEL=gemini-text-model
GEMINI_TTS_MODEL=gemini-tts-model
