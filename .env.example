# Public URL used by the mobile client. Copy this file to .env for local use.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_SITE_URL=https://toneyarthi.com
# Must match the EAS build profile and backend registration environment.
EXPO_PUBLIC_APP_ENVIRONMENT=development
# Release is supplied by Expo app.json/EAS. Mobile crash reports contain only
# platform, fatal flag, error class, environment, and release metadata.

# Public R2 development domain or, in production, the bucket's custom domain.
MEDIA_PUBLIC_BASE_URL=https://pub-account-specific-id.r2.dev

# Cloudflare identifiers and secrets will be introduced with their integrations.
INGEST_TRIGGER_SECRET=replace-with-a-development-secret

# Worker observability tags. Override RELEASE with the immutable deployed git SHA.
ENVIRONMENT=development
RELEASE=local
# Optional export is configured at the Cloudflare account level (Logpush or
# Workers Observability); never expose provider credentials to the mobile app.

# Next.js admin credentials and server-only API access. Never prefix these with NEXT_PUBLIC_.
ADMIN_EMAIL=editor@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_BASE_URL=http://localhost:8787
ADMIN_API_TOKEN=replace-with-the-worker-admin-api-token

# Gemini client credentials and model selections (server-side only).
GEMINI_API_KEY=replace-with-a-gemini-api-key
GEMINI_TEXT_MODEL=gemini-text-model
GEMINI_TTS_MODEL=gemini-tts-model
