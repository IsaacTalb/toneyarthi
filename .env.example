# Local development only. Remote builds/deployments use their explicit contracts.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8787
EXPO_PUBLIC_SITE_URL=http://localhost:3000
EXPO_PUBLIC_APP_ENVIRONMENT=development
ENVIRONMENT=development
RELEASE=local

# Server-only local admin configuration.
APP_ENVIRONMENT=development
ADMIN_EMAIL=editor@example.test
ADMIN_PASSWORD=replace-with-a-strong-local-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_API_BASE_URL=http://localhost:8787
ADMIN_API_TOKEN=replace-with-the-local-worker-admin-token
